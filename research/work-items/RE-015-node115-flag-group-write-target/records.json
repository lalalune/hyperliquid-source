  "tag_model": {
    "rule": "bit 0 of the fourth argument selects the inline path; on the scan path a template byte below 0x80 is a literal run of that length, 0x80 is a u16-length literal run, any other byte >= 0x81 is a placeholder tag: 0xc0 dispatches the sequential record with the default spec block, other tags read spec (bit 0), field A (bit 1), field B (bit 2) and an explicit index (bit 3) from the payload in that order, and bits 4/5 replace fields A/B with the u16 at arguments[field * 16 + 8]",
    "descriptor_rule": "each dispatch builds a 24-byte descriptor {out, table, spec dword, field A u16, field B u16} and calls the record formatter word at +0x8 with the record value word at +0x0 as its first argument",
    "counter_rule": "after a successful dispatch the sequential index becomes the dispatched index plus one",
    "return_rule": "AL is 0 iff the walk reaches the template terminator with no callee error; any literal write or dispatch error returns AL 1; the inline path returns the table method's AL unchanged"
