    "P80": "1111111111111111111111111111111111111111111111111111111111111180",
    "Pff": "11111111111111111111111111111111111111111111111111111111111111ff"
  },
  "row_encoding": "physical_rows lists EVERY allocated slot in physical-index order as [key_catalogue_id, opaque_nonzero_u64_decimal_string]. These strings are values, never native reference counts.",
