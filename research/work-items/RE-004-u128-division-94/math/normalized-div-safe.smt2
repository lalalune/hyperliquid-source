(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const n Real)
(declare-const s Real)
(declare-const a Real)
(define-fun m () Real 18446744073709551616)
(assert (>= n 0))
(assert (< n (* m m)))
(assert (>= s 0))
(assert (<= (* 2 s) n))
(assert (<= n (+ (* 2 s) 1)))
(assert (>= a (/ m 2)))
(assert (>= s (* a m)))
(check-sat)
