(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const a Real)
(declare-const h Real)
(declare-const e Real)
(declare-const r0 Real)
(declare-const r1 Real)
(declare-const r2 Real)
(assert (>= a 1))
(assert (>= h 1))
(assert (>= e 0))
(assert (and (>= r0 0) (<= r0 1)))
(assert (and (>= r1 0) (<= r1 (- a 1))))
(assert (and (>= r2 0) (<= r2 (- h 1))))
(define-fun t () Real (* 2 a h))
(define-fun n () Real (+ (* 2 (+ (* a (+ (* h e) r2)) r1)) r0))
(define-fun remainder () Real (- n (* t e)))
(assert (or (< remainder 0) (>= remainder t)))
(check-sat)
