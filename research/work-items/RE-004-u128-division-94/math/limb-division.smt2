(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const m Real)
(declare-const d Real)
(declare-const nh Real)
(declare-const nl Real)
(declare-const qh Real)
(declare-const rh Real)
(declare-const ql Real)
(declare-const rl Real)
(assert (>= m 2))
(assert (>= d 1))
(assert (= nh (+ (* qh d) rh)))
(assert (= (+ (* rh m) nl) (+ (* ql d) rl)))
(define-fun n () Real (+ (* nh m) nl))
(define-fun q () Real (+ (* qh m) ql))
(assert (not (= n (+ (* q d) rl))))
(check-sat)
