(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const t Real)
(declare-const d Real)
(declare-const n Real)
(declare-const e Real)
(declare-const q Real)
(assert (> t 0))
(assert (>= d t))
(assert (>= n 0))
(assert (>= q 0))
(assert (<= (* e t) n))
(assert (< n (* (+ e 1) t)))
(assert (<= (* q d) n))
(assert (< n (* (+ q 1) d)))
; Integer e<q implies e+1<=q. Prove this stronger real relaxation impossible.
(assert (<= (+ e 1) q))
(check-sat)
