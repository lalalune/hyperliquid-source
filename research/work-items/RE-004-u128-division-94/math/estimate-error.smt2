; Real relaxation of the target's truncated-denominator estimate bound.
(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const h Real)
(declare-const t Real)
(declare-const delta Real)
(declare-const n Real)
(define-fun m () Real 18446744073709551616)
(define-fun d () Real (+ t delta))
(assert (>= h 1))
(assert (> t 0))
(assert (>= t (* m h)))
(assert (>= delta 0))
(assert (<= delta (- (* 2 h) 1)))
(assert (>= n 0))
(assert (< n (* m m)))
; Negation of n/t - n/d < 1 after multiplying by positive t*d.
(assert (>= (* n delta) (* t d)))
(check-sat)
