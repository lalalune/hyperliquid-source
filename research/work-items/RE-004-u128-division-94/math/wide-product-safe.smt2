(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const n Real)
(declare-const dh Real)
(declare-const dl Real)
(declare-const q0 Real)
(define-fun m () Real 18446744073709551616)
(define-fun d () Real (+ (* dh m) dl))
(assert (>= dh 1))
(assert (and (>= dl 0) (< dl m)))
(assert (and (>= n 0) (< n (* m m))))
(assert (>= q0 0))
(assert (<= (* q0 d) n))
(assert (>= (* q0 dh) m))
(check-sat)
