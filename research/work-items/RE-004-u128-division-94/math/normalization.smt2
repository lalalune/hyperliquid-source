(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const h Real)
(declare-const dh Real)
(declare-const dl Real)
(declare-const a Real)
(define-fun m () Real 18446744073709551616)
(define-fun d () Real (+ (* dh m) dl))
(assert (>= h 1))
(assert (>= dh h))
(assert (<= dh (- (* 2 h) 1)))
(assert (>= dl 0))
(assert (<= dl (- m 1)))
(assert (<= (* (* 2 h) a) d))
(assert (< d (* (* 2 h) (+ a 1))))
(assert (or (<= a (- (/ m 2) 1)) (>= a m)))
(check-sat)
